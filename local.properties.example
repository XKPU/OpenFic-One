# 复制为 local.properties 后按本机情况修改；此文件不进仓库。
# 构建脚本优先读取环境变量，其次读取这里的值。

# Android SDK 根目录
sdk.dir=

# 可选：指定 build-tools 版本（默认取已安装的最高版本）
build.tools=

# 可选：指定编译用 platform（默认取已安装的最高 android-NN）
compile.sdk=

# 可选：JDK 根目录（默认使用 JAVA_HOME 或 PATH 上的 javac）
java.home=

# 可选：Python 解释器（默认使用 PYTHON 环境变量或 PATH 上的 python）
python=

# 可选：签名密钥库（默认 app/keystore/debug.keystore）
keystore=
keystore.alias=
keystore.storepass=
keystore.keypass=
